OBSCHAIN_HOST=127.0.0.1
OBSCHAIN_PORT=8080

MEMPOOL_API_URL=https://mempool.space/api
MEMPOOL_WS_URL=wss://mempool.space/api/v1/ws

# Threshold for LargeTransactionDetector in satoshis (preferred) or BTC
# 10,000,000,000 sats = 100 BTC
OBSCHAIN_LARGE_TX_THRESHOLD_SATS=10000000000
# OBSCHAIN_LARGE_TX_THRESHOLD_BTC=100

# Threshold for LongBlockIntervalDetector in seconds (default 1800 = 30 minutes)
OBSCHAIN_LONG_BLOCK_INTERVAL_SECONDS=1800

# Dormant Coin Detector configuration
# Default: 1825 days (5 years), 100,000,000 sats (1 BTC)
OBSCHAIN_DORMANT_MIN_AGE_DAYS=1825
OBSCHAIN_DORMANT_MIN_VALUE_SATS=100000000
# OBSCHAIN_DORMANT_MIN_VALUE_BTC=1

# UTXO Consolidation Detector configuration
# Default: minimum 20 inputs, maximum 5 outputs, min value 0 sats
OBSCHAIN_CONSOLIDATION_MIN_INPUTS=20
OBSCHAIN_CONSOLIDATION_MAX_OUTPUTS=5
OBSCHAIN_CONSOLIDATION_MIN_VALUE_SATS=0

# High Fan-Out Detector configuration
# Default: minimum 50 outputs
OBSCHAIN_FANOUT_MIN_OUTPUTS=50
OBSCHAIN_FANOUT_MIN_VALUE_SATS=0

# Extreme Fee Detector configuration
# Default: 10,000,000 sats (0.1 BTC) or 200 sat/vB fee rate
OBSCHAIN_EXTREME_FEE_SATS=10000000
OBSCHAIN_EXTREME_FEE_RATE_SAT_VB=200.0

# UTXO Historical Cache and Bounded Enrichment Layer
OBSCHAIN_UTXO_CACHE_LIMIT=50000
OBSCHAIN_UTXO_CACHE_TTL_SECONDS=3600
OBSCHAIN_MAX_INPUT_ENRICHMENT=500
OBSCHAIN_UTXO_LOOKUP_CONCURRENCY=16

# Event Deduplication Cache
OBSCHAIN_DEDUP_CAPACITY=10000
OBSCHAIN_DEDUP_TTL_SECONDS=1800

# In-memory circular event store capacity limit (maximum recent events retained)
OBSCHAIN_EVENT_STORE_LIMIT=10000

# In-memory circular incident activity store capacity limit
OBSCHAIN_ACTIVITY_STORE_LIMIT=10000

# Incident Watch Engine UTXO descendant tracking depth (bounded 1-5, default 3)
OBSCHAIN_INCIDENT_FOLLOW_DEPTH=3

# Set to true only if running with simulated mock seed data for isolated UI demos
OBSCHAIN_MOCK_FEED=false

# Storage Backend Selection: "memory" (default safe dev mode) or "postgres"
OBSCHAIN_STORAGE_BACKEND=memory

# PostgreSQL Configuration (active when OBSCHAIN_STORAGE_BACKEND=postgres)
# Example local development URL (credentials must never be committed)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5433/obschain
OBSCHAIN_DB_MAX_CONNECTIONS=10
OBSCHAIN_DB_MIN_CONNECTIONS=1
OBSCHAIN_DB_ACQUIRE_TIMEOUT_SECONDS=5

# Phase 5: Sovereign Bitcoin Core Ingestion Configuration
OBSCHAIN_BITCOIN_CORE_ENABLED=false
BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_COOKIE_FILE=

BITCOIN_ZMQ_RAWTX=tcp://127.0.0.1:28332
BITCOIN_ZMQ_RAWBLOCK=tcp://127.0.0.1:28333
BITCOIN_ZMQ_SEQUENCE=tcp://127.0.0.1:28334

# Network validation: bitcoin, testnet, testnet4, signet, regtest
OBSCHAIN_BITCOIN_NETWORK=bitcoin

# Primary source selection: auto, bitcoin_core, mempool_space
OBSCHAIN_PRIMARY_SOURCE=auto

# Sovereign-only mode: when true, never contact public mempool.space services (strict privacy)
OBSCHAIN_SOVEREIGN_ONLY=false

# Maximum blocks to reconcile across chain gap before triggering alert
OBSCHAIN_RECONCILE_MAX_BLOCKS=100

RUST_LOG=info,obschain=debug,obschain_ingest=debug


